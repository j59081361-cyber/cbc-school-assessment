{
  "name": "cbc-analytics",
  "productName": "CBC School Results Analytics",
  "version": "1.4.0",
  "description": "Offline CBC school results analytics",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "ke.school.cbcanalytics",
    "productName": "CBC School Results Analytics",
    "files": [
      "main.js",
      "preload.js",
      "storage.js",
      "app/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CBC Results Analytics",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "directories": {
      "buildResources": "build"
    },
    "artifactName": "CBC-Results-Analytics-Setup-${version}.${ext}"
  }
}
